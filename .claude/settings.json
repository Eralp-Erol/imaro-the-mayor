{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "availableModels": ["opus", "sonnet", "claude-opus-5-5", "claude-sonnet-5-5"],
  "permissions": {
    "allow": [
      "Bash(tools/verify.sh:*)",
      "Bash(tools/capture.sh:*)",
      "Bash(tools/visual-diff.sh:*)",
      "Bash(tools/godot.sh:*)",
      "Bash(tools/canon-check.sh)",
      "Bash(tools/fingerprint.sh)",
      "Bash(tools/blender/start-mcp.sh:*)",
      "Bash(uvx --from gdtoolkit==4.5.0 gdlint:*)",
      "Bash(uvx --from gdtoolkit==4.5.0 gdformat:*)",
      "Bash(magick compare:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(rg:*)",
      "Bash(jq:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)"
    ],
    "deny": [
      "Edit(design/foundation/**)",
      "Write(design/foundation/**)",
      "Agent(statusline-setup)"
    ]
  },
  "enabledMcpjsonServers": ["blender"],
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh", "timeout": 20 }] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-canon.sh", "timeout": 10 }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__.*",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-canon-verify.sh", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-verify-gate.sh", "timeout": 30 }] }
    ]
  }
}
