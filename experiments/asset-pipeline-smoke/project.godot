; Disposable asset-pipeline smoke project (ignored by the main Godot project via experiments/.gdignore).
config_version=5

[application]
config/name="Imaro Asset Pipeline Smoke (disposable)"
config/features=PackedStringArray("4.7", "GL Compatibility")

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
